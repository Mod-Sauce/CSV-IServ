#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "csv.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 2,1,0,0
    PRODUCTVERSION 2,1,0,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0x0L
    FILEOS VOS__WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Moritz Breier"
            VALUE "FileDescription", "CSV converter for IServ import"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "InternalName", "csv_converter"
            VALUE "LegalCopyright", "Copyright (C) 2025 Moritz Breier"
            VALUE "OriginalFilename", "csv_converter.exe"
            VALUE "ProductName", "CSV-IServ-Converter"
            VALUE "ProductVersion", "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
